# Application Settings
APP_NAME=UltraFast-Redirector
APP_PORT=8080
APP_ENV=development
BASE_URL=http://localhost:8080
SERVER_READ_TIMEOUT_SEC=5

# Database Settings (PostgreSQL Primary Database)
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=shortener_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME_MIN=30

# Redis Cache & Queue Settings (Ultra-Fast In-Memory Caching & Background Event Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=200
REDIS_MIN_IDLE_CONNS=50
REDIS_DIAL_TIMEOUT_MS=2000
REDIS_READ_TIMEOUT_MS=1000
REDIS_WRITE_TIMEOUT_MS=1000
REDIS_STREAM_KEY=stream:clicks
REDIS_QUEUE_KEY=queue:clicks

# JWT Authentication (Provide a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_MINUTES=1440

# Background Click Collector Worker
WORKER_BATCH_SIZE=100
WORKER_FLUSH_INTERVAL_MS=1000
WORKER_COUNT=4
