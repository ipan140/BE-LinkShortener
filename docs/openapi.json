{
  "openapi": "3.0.0",
  "info": {
    "title": "Ultra-Fast Redirector & Click Collector API",
    "version": "1.2.0",
    "description": "High-performance modular monolith for <10ms short link redirection with Smart Device Routing, QR generator, UTM forwarder, password protection, max click limits, CSV export, and Redis rate limiting."
  },
  "paths": {
    "/{code}": {
      "get": {
        "summary": "Ultra-fast redirection (<10ms) with Smart Device Routing (iOS/Android) & UTM forwarding",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "p",
            "in": "query",
            "required": false,
            "description": "Optional access password if shortlink is password protected",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": { "description": "Redirects to destination URL with forwarded query params" },
          "401": { "description": "Password required or invalid password" },
          "404": { "description": "Short code not found" },
          "429": { "description": "Rate limit exceeded" }
        }
      },
      "post": {
        "summary": "Submit password for a protected short link",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ]
      }
    },
    "/qr/{code}": {
      "get": {
        "summary": "Public QR Code PNG generator",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 256 }
          }
        ],
        "responses": {
          "200": { "description": "Returns image/png QR Code binary" }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a new user account"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Authenticate and obtain JWT token"
      }
    },
    "/api/v1/links": {
      "post": {
        "summary": "Create short link (Supports custom alias, ios_url, android_url, password, max_clicks, expires_at)"
      },
      "get": {
        "summary": "List user's shortened links"
      }
    },
    "/api/v1/analytics/{code}": {
      "get": {
        "summary": "Get click statistics and visitor demographics"
      }
    },
    "/api/v1/analytics/{code}/export.csv": {
      "get": {
        "summary": "Download raw click log telemetry as CSV file"
      }
    }
  }
}
